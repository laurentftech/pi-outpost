# This project's one dependency is npm itself. npm bundles its own dependencies, and
# npm 12 reads those from the release tarball by URL — which its default
# `allow-remote=none` refuses even for a registry tarball. The tarball is still checked
# against the integrity hash in package-lock.json, so allowing it here, and only here,
# loses no verification. The rest of the repository keeps npm's default.
allow-remote=all
