# Existing project directory. Relative paths resolve beside compose.yml.
PROJECT_DIR=./workspace
PI_OUTPOST_VERSION=0.59.1
LANDSTRIP_VERSION=0.20.20
PI_OUTPOST_PORT=3141
# OFF by default. Set to 1 only to allow agent/terminal apps to listen inside the
# container, then explicitly publish the chosen app port on loopback in Compose.
ALLOW_APP_LISTENERS=0
# Linux bind mounts must be writable by this UID/GID. Docker Desktop users can
# normally keep 1000. On Linux, set these to your `id -u` / `id -g`, then rebuild.
APP_UID=1000
APP_GID=1000
# Linux with AppArmor: load profiles/pi-outpost-landstrip.apparmor and set this to
# pi-outpost-landstrip. Docker Desktop without AppArmor can use unconfined.
LANDSTRIP_APPARMOR_PROFILE=unconfined
