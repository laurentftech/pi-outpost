{
  "name": "@pi-outpost/embed",
  "version": "0.51.0",
  "type": "module",
  "description": "Mount pi-outpost as a Shadow-DOM-isolated widget inside another web app.",
  "license": "MIT",
  "author": "Laurent Francoise",
  "homepage": "https://github.com/laurentftech/pi-outpost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurentftech/pi-outpost.git",
    "directory": "embed"
  },
  "bugs": {
    "url": "https://github.com/laurentftech/pi-outpost/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "agent",
    "ai",
    "ai-agent",
    "llm",
    "chat",
    "web-ui",
    "web-interface",
    "widget",
    "embeddable",
    "shadow-dom",
    "react",
    "embed"
  ],
  "main": "./dist/pi-outpost-embed.cjs",
  "module": "./dist/pi-outpost-embed.js",
  "types": "./dist/mount.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/pi-outpost-embed.js",
      "require": "./dist/pi-outpost-embed.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@pi-outpost/shared": "*",
    "@pi-outpost/ui": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "highlight.js": "^11.12.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
