{
  "name": "@pi-outpost/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --import tsx --import ./src/providerStackHook.mjs src/index.ts --config ../pi-outpost.config.dev.json",
    "start": "node --import tsx --import ./src/providerStackHook.mjs src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint src --max-warnings 43",
    "build": "tsc --noEmit",
    "build:sea": "node scripts/build-sea.mjs",
    "test": "node scripts/test.mjs",
    "test:live": "node --test --test-timeout=180000 test/live/*.test.mjs",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.4",
    "@pi-outpost/office": "*",
    "@pi-outpost/posters": "*",
    "@pi-outpost/shared": "*",
    "docx": "^9.11.0",
    "fastify": "^5.12.7",
    "katex": "^0.18.7",
    "pdfjs-dist": "6.4.299",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "typebox": "1.3.18",
    "unified": "^11.0.5",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@microsoft/mxc-sdk": "^1.0.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "monocart-coverage-reports": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
