<mxfile host="pi-outpost">
  <diagram id="vehicule-architecture" name="Architecture électrique">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bms" value="BMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="battery" value="Batterie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="190" width="180" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="inverter" value="Onduleur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="190" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="motor" value="Moteur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="190" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="charge-port" value="Prise de recharge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="charger" value="Chargeur embarqué" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="500" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dcdc" value="Convertisseur DC/DC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="network12" value="Réseau 12 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="500" width="170" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="bms-measures" value="mesures cellules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="bms" target="battery">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bms-cutoff" value="ordre de coupure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="bms" target="battery">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="battery-inverter" value="puissance HT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="battery" target="inverter">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="inverter-motor" value="courant triphasé" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="inverter" target="motor">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="motor-inverter" value="régénération" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.65;entryX=1;entryY=0.65;" edge="1" parent="1" source="motor" target="inverter">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="port-charger" value="courant AC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="charge-port" target="charger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="charger-battery" value="charge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="charger" target="battery">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="battery-dcdc" value="puissance HT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="battery" target="dcdc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="dcdc-network" value="alimentation 12 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dcdc" target="network12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
