        <mxCell id="flux-triphasé" value="courant triphasé" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="onduleur" target="moteur">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flux-regen" value="régénération" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;exitX=0;exitY=0.25;entryX=1;entryY=0.25;" edge="1" parent="1" source="moteur" target="onduleur">
