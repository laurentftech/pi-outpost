        <mxCell id="flux-12v" value="alimentation 12 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dcdc" target="reseau12">
          <mxGeometry relative="1" as="geometry"/>
