<mxfile host="pi-outpost">
  <diagram id="traitement-commande" name="Traitement d'une commande">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="reception" value="Réception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="40" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="stock" value="Stock disponible ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="160" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="reappro" value="Réapprovisionnement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="180" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="paiement" value="Paiement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="paiement-ok" value="Paiement accepté ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="450" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="preparation" value="Préparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="620" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="expedition" value="Expédition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="750" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="annulation" value="Annulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="470" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="notification" value="Notification client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="750" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e-reception-stock" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="reception" target="stock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stock-oui" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stock" target="paiement">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stock-non" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="stock" target="reappro">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-reappro-retour" value="retour à la décision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="reappro" target="stock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-paiement-decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="paiement" target="paiement-ok">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-paiement-oui" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="paiement-ok" target="preparation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-paiement-non" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="paiement-ok" target="annulation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-preparation-expedition" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="preparation" target="expedition">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-expedition-notification" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="expedition" target="notification">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="780"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-annulation-notification" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="annulation" target="notification">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="620"/><mxPoint x="900" y="620"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
