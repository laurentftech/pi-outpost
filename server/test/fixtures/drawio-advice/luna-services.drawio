        <mxCell id="gateway-auth" value="jeton" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;exitX=0.6;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="gateway" target="auth">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="220"/><mxPoint x="440" y="220"/></Array></mxGeometry>
