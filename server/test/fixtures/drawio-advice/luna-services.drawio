        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="gateway" value="Passerelle API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="180" height="70" as="geometry"/>
