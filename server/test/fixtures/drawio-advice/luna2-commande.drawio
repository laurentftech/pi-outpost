<mxfile host="pi-outpost">
  <diagram id="commande-flow" name="Traitement d'une commande">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1400" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="reception" value="Réception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="stock" value="Stock disponible ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="paiement" value="Paiement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="160" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="paiement-ok" value="Paiement accepté ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="preparation" value="Préparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="expedition" value="Expédition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1030" y="160" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="notification" value="Notification client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1030" y="390" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="reapprovisionnement" value="Réapprovisionnement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="220" y="360" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="annulation" value="Annulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e-reception-stock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="reception" target="stock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stock-yes" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="stock" target="paiement">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stock-no" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stock" target="reapprovisionnement">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-restock-return" value="retour" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="reapprovisionnement" target="stock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-payment-decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="paiement" target="paiement-ok">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-payment-yes" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="paiement-ok" target="preparation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-payment-no" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="paiement-ok" target="annulation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-prep-ship" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="preparation" target="expedition">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ship-notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="expedition" target="notification">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cancel-notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="annulation" target="notification">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="390"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
