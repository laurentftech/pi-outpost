
# openlore analysis artifacts
.openlore/

node_modules/
dist/
*.log
.DS_Store
.env
.code-review-graph/

# Local agent tooling and its output — each checkout configures its own
.claude/
.agents/
.mcp.json
.playwright-mcp/

# Sample documents used to try the readers by hand: personal, and often large
exemples/

# The web UI inlined into a TypeScript module for the npm/SEA bundles (~9 MB).
# Generated by the builds that need it; `npm install` writes an empty stub so a
# fresh clone starts and typechecks. Committing it served a stale UI to anyone who
# rebuilt web/ — index.ts prefers the inlined bundle over web/dist.
server/src/embedded-web.ts

# Test coverage artifacts (vitest --coverage)
coverage/

# Browser smoke test: the built host page, and what a failing run leaves behind
e2e/dist-host/
e2e/test-results/

# Local test config (personal): the agent's workspace, its own agentDir, its writable zone
/pi-outpost.config.json
.pi-outpost-test-agent/
scratch/

# Agent resources the running agent discovers from cwd (prompts, skills). Local to
# each checkout — the project's own copies live in .claude/.
.pi/
.pi-agent/

# Interactive test ephemeral data
interactive-test/workspace/
interactive-test/.pi-agent/
interactive-test/*.log
.omo/run-continuation/
RELEASE_NOTES.md

# Local tooling that lives beside the checkout but is nobody else's business:
# rtk's project filters, Zed's per-project settings, and an oh-my-posh theme.
.rtk/
.zed/
/pi-outpost.config.omp.json

# Playwright MCP leaves snapshots and console logs where it is driven from
.playwright-mcp/
