# Copy to .env and fill in. Generate each secret with: openssl rand -hex 32

# Open WebUI's own session secret.
WEBUI_SECRET_KEY=

# The bearer key Open WebUI presents to pi-outpost's server.
OUTPOST_SECRET=

# The key Open WebUI signs users with, and pi-outpost's server checks them with.
OUTPOST_IDENTITY_KEY=

# Optional: enable saving poster edits from the browser. Use the address the browser
# can reach (not the Docker service name). For local access, these defaults fit the
# compose ports; for LAN access set the host LAN IP and OUTPOST_PUBLISH below.
# OUTPOST_PUBLIC_URL=http://localhost:8790
# OUTPOST_WEBUI_ORIGIN=http://localhost:3000
# Browser-facing pi-outpost port. Loopback by default; for LAN access, bind explicitly.
# OUTPOST_PUBLISH=0.0.0.0:8790:8790

# The model provider, OpenAI-compatible. Examples:
#   Mistral: https://api.mistral.ai/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# Several providers: separate URLs, and their keys in the same order, with ";".
OPENAI_API_BASE_URLS=https://api.mistral.ai/v1
OPENAI_API_KEYS=

# Optional.
# OPEN_WEBUI_PORT=3000
# OPEN_WEBUI_VERSION=v0.11.4
# The server image. Default: the latest release on ghcr.io. For a version not
# released yet, build it from a clone of the repository and name it here:
#   docker build -f openwebui/Dockerfile -t pi-outpost-openwebui .
# OUTPOST_IMAGE=pi-outpost-openwebui
# Open WebUI on this machine only (the default listens on every interface):
# OPEN_WEBUI_PORT=127.0.0.1:3000
# Word and PowerPoint templates the model may use, by file name (default: ./templates):
# OUTPOST_TEMPLATES=./templates
