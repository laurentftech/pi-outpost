    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
