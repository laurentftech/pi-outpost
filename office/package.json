{
  "name": "@pi-outpost/office",
  "private": true,
  "type": "module",
  "description": "Word and PowerPoint builders: pure functions over bytes, shared by pi-outpost's server and the Open WebUI tool server.",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
