{
  "//": "The Playwright specs and their support files, checked the way Playwright loads them (bundler resolution, extensionless imports). Run by the root `typecheck` script: e2e is not a workspace.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@pi-outpost/embed": ["../embed/src/mount.tsx"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
