{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // One rule, over the test sources only (run by the root `lint`): a test may not silence
  // the type checker. `@ts-ignore` and `@ts-nocheck` are refused; `@ts-expect-error` is
  // allowed with a description saying why the error is expected. Every other rule stays
  // with each workspace's own configuration.
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript"],
  "rules": {
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 3
      }
    ]
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**"]
}
