{
  "name": "pi-outpost",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web",
    "embed",
    "cli",
    "ui",
    "apps-core",
    "office",
    "posters",
    "openwebui",
    "mcp"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-embedded-web.mjs",
    "predev": "node scripts/ensure-embedded-web.mjs --reset",
    "predev:server": "node scripts/ensure-embedded-web.mjs --reset",
    "prestart": "node scripts/ensure-embedded-web.mjs --reset",
    "prebench": "node scripts/ensure-embedded-web.mjs --reset",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run build --workspace web && npm run start --workspace server",
    "build": "npm run build --workspaces --if-present",
    "build:validator": "node shared/scripts/build-validator.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e && tsc -p fuzz",
    "lint": "npm run lint --workspaces --if-present && npm run lint:test-comments",
    "lint:test-comments": "oxlint -c .oxlintrc.test-comments.json ui/src server/test e2e",
    "check:css": "node scripts/check-web-css.mjs",
    "check:embed": "node scripts/check-embed-package.mjs",
    "check:cli": "node scripts/check-cli-package.mjs",
    "check:scenarios": "node scripts/check-scenario-coverage.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:linux": "node scripts/test-linux.mjs",
    "build:e2e-host": "vite build --config e2e/vite.config.ts",
    "pretest:e2e": "node scripts/ensure-embedded-web.mjs --reset",
    "test:e2e": "npm run build:e2e-host && playwright test --config e2e/playwright.config.ts",
    "pretest:webbench": "node scripts/ensure-embedded-web.mjs --reset",
    "test:webbench": "npm run build:e2e-host && playwright test --config e2e/web-bench.config.ts",
    "bench": "tsx scripts/embed-bench.mts",
    "check:export-chunk": "node scripts/check-export-chunk.mjs",
    "test:npm-install": "node scripts/check-npm-install.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "jsdom": "~30.0.1",
    "monocart-coverage-reports": "^3.2.1"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "^0.18.10"
    },
    "micromark-extension-math": {
      "katex": "^0.18.10"
    }
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.3": true,
    "node-pty@1.1.0": true,
    "protobufjs": false
  },
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.2.2 <13"
  }
}
