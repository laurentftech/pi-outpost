import { rm } from "node:fs/promises";
import path from "node:path";
import { chromium } from "@playwright/test";
const info = JSON.parse(process.argv[2]!);
const browser = await chromium.launch();
const page = await browser.newPage();
await page.goto(info.url);
await page.getByRole("button", { name: "Settings" }).click();
const s = page.getByTestId("pi-packages");
await s.getByRole("button", { name: "Undo" }).click();
await page.getByText("1.0.0 — 1.1.0 available").first().waitFor({ timeout: 60000 });
await rm(path.join(info.agentDir, "npm", "node_modules", "pi-fake-ext"), { recursive: true, force: true });
await s.getByRole("button", { name: "check for updates" }).click();
await page.waitForTimeout(10000);
console.log("after delete:", await s.getByTestId("pi-package").allInnerTexts(), await page.getByTestId("restart-needed").allInnerTexts());
await s.getByRole("button", { name: "Remove pi-fake-ext" }).click();
await s.getByTestId("pi-package-confirm").getByRole("button", { name: "Remove" }).click();
await page.waitForTimeout(4000);
console.log("after remove:", await s.getByTestId("pi-package").allInnerTexts(), await page.getByTestId("restart-needed").allInnerTexts());
await browser.close();
